# Server
PORT=8080
ENV=development

# Database
DATABASE_URL=postgres://blueprint:blueprint@localhost:5432/blueprint_roi?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# Auth
BLUEPRINT_ADMIN_KEY=change-me-in-production

# Blueprint Command Reseller Keys
# Super admin key prefix: bpa_super_<any-suffix>
# Partner key format:     bpa_partner_<uuid>
# Example: ADMIN_KEY=bpa_super_my-secret-key

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Notifications (optional)
DISCORD_WEBHOOK_URL=

# Email (optional — SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com

# PDF (optional — headless Chrome path)
CHROME_PATH=

# CRM (optional — per-tenant, set via admin API)
# HUBSPOT_API_KEY=
# GHL_API_KEY=

# ── Blueprint Portals Billing ────────────────────────────────────────────────
PORTALS_URL=
BPA_INTERNAL_KEY=
