{
  "name": "02 - HubSpot CRM Sync",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "blueprint-hubspot-sync",
        "responseMode": "onReceived"
      },
      "id": "webhook-trigger",
      "name": "Webhook - Lead Submitted",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "authentication": "apiKey",
        "resource": "contact",
        "operation": "upsert",
        "additionalFields": {
          "company": "={{ $json.businessName }}",
          "phone": "={{ $json.contactPhone }}"
        },
        "email": "={{ $json.contactEmail }}",
        "firstName": "={{ $json.contactName.split(' ')[0] }}",
        "lastName": "={{ $json.contactName.split(' ').slice(1).join(' ') }}"
      },
      "id": "hubspot-contact",
      "name": "Upsert HubSpot Contact",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "authentication": "apiKey",
        "resource": "deal",
        "operation": "create",
        "dealName": "={{ $('Webhook - Lead Submitted').item.json.businessName }} — Automation Audit",
        "stage": "appointmentscheduled",
        "amount": "={{ $('Webhook - Lead Submitted').item.json.roiCalculation?.annualValue || 0 }}",
        "additionalFields": {
          "associatedContactIds": ["={{ $json.id }}"]
        }
      },
      "id": "hubspot-deal",
      "name": "Create HubSpot Deal",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [680, 300]
    }
  ],
  "connections": {
    "Webhook - Lead Submitted": { "main": [[{ "node": "Upsert HubSpot Contact", "type": "main", "index": 0 }]] },
    "Upsert HubSpot Contact": { "main": [[{ "node": "Create HubSpot Deal", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
